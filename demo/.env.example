# Sao chép file này thành ".env" (cùng thư mục với pom.xml) rồi điền giá trị thật.
# File ".env" đã được loại khỏi Git, KHÔNG commit nó.

# --- Database (mặc định: localhost, user root, mật khẩu rỗng) ---
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=jdbc:mysql://localhost:3306/library_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Ho_Chi_Minh

# --- Mailtrap (lấy ở Inbox > SMTP Settings) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- JWT: chuỗi Base64 của ít nhất 32 byte ngẫu nhiên ---
# PowerShell:  $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Git Bash / Linux:  openssl rand -base64 48
JWT_SECRET=
